 src/jsonsync.rs             |  14 ++--
 src/profile.rs              |  70 ++++++++++++++++-
 tests/inline/claude_json.rs | 148 ++++++++++++++++++++++++++++++++++++
 4 files changed, 226 insertions(+), 9 deletions(-)


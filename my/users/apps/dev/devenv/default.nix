{ lib, ... }@args:

# devenv, and the dev WORKSPACE: one devenv at the root of the user's code
# tree carrying the development CLIs, so the host itself carries none.
#
# direnv loads the nearest .envrc only, and repos (third-party ones included)
# often have their own. The workspace therefore has two entry points:
#   - <workspace>/.envrc (`use devenv`) for any directory without its own;
#   - direnv's stdlib (direnvrc, sourced before EVERY .envrc) prepends the
#     workspace profile's bin/ inside the workspace, so a repo's own devenv
#     still loads after it and still wins on conflicts.
# The workspace is on direnv's whitelist, so nothing needs `direnv allow`.
(import ../../../../../lib/mk-app.nix).mkApp args {
  path = "dev.tools.devenv";
  option = {
    name = "devenv";
    default = false;
    description = "devenv development environment manager";
    persistedDirectories = [ ];
    extraOptions = {
      workspace = {
        directory = lib.mkOption {
          type = lib.types.nullOr (lib.types.strMatching "[^/].*");
          default = null;
          example = "Code";
          description = ''
            Directory under the home holding the code tree, made a devenv
            workspace: devenv.nix, devenv.yaml and .envrc are generated there,
            and direnv loads it without a manual allow. Null: no workspace.
          '';
        };
        packages = lib.mkOption {
          type = lib.types.listOf (lib.types.strMatching "[A-Za-z0-9_.-]+");
          default = [ "gh" "glab" "lazygit" "delta" "git-lfs" "jujutsu" ];
          example = [ "gh" "nil" "marksman" ];
          description = ''
            nixpkgs attribute names put on PATH inside the workspace. Names,
            not packages: devenv evaluates them against its own nixpkgs input,
            so none of them enters the system closure.
          '';
        };
      };
    };
  };
  home = { pkgs, lib, cfg, config, name, ... }:
    let
      ws = cfg.workspace;
      root = "${config.users.users.${name}.home or "/home/${name}"}/${ws.directory}";
    in
    lib.mkMerge [
      { home.packages = [ pkgs.devenv ]; }

      (lib.mkIf (ws.directory != null) {
        home.file = {
          "${ws.directory}/devenv.nix".text = ''
            # Generated by mynixos (apps.dev.tools.devenv.workspace); edits are overwritten.
            { pkgs, ... }:
            {
              packages = with pkgs; [
            ${lib.concatMapStrings (p: "    ${p}\n") ws.packages}  ];
            }
          '';
          "${ws.directory}/devenv.yaml".text = ''
            # Generated by mynixos (apps.dev.tools.devenv.workspace).
            inputs:
              nixpkgs:
                url: github:cachix/devenv-nixpkgs/rolling
          '';
          "${ws.directory}/.envrc".text = ''
            # Generated by mynixos (apps.dev.tools.devenv.workspace).
            eval "$(devenv direnvrc)"
            use devenv
          '';
        };

        programs.direnv = {
          config.whitelist.prefix = [ root ];
          stdlib = ''
            # mynixos dev workspace: its CLIs inside every directory of ${root},
            # including repos with their own .envrc (which load after this).
            case "$PWD/" in
              ${root}/*)
                if [ -d ${root}/.devenv/profile/bin ]; then
                  PATH_add ${root}/.devenv/profile/bin
                fi
                ;;
            esac
          '';
        };
      })
    ];
}

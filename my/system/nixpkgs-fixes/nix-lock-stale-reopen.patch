+/**
+ * Whether a lock file we have just locked is no longer at `lockPath`, so
+ * that other processes may create and acquire a lock on `lockPath`.
+ */
+static bool isLockFileStale(Descriptor fd, const std::filesystem::path & lockPath)
+{
+    auto st = nix::fstat(fd);
+    if (st.st_nlink == 0)
+        return true;
+
+    /* deleteLockFile() writes its token after trying to unlink, so an empty
+       file with a link is live. */
+    if (st.st_size == 0)
+        return false;
+
+    /* A token alone doesn't mean the file was removed, since deleteLockFile()
+       allows the unlink to fail, and such a file is a usable lock.  The link
+       count can't tell the two apart: an NFS client renames a file that is
+       still open rather than removing it.  So see what the path names. */
+    auto atPath = openLockFile(lockPath, false);
+    if (!atPath)
+        return true;
+    auto stAtPath = nix::fstat(atPath.get());
+    return stAtPath.st_dev != st.st_dev || stAtPath.st_ino != st.st_ino;
+}

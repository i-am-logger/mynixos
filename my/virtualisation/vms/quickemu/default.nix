# my.virtualisation.vms.quickemu and machines with engine = "quickemu".
#
# quickemu runs a VM as an ordinary process of its owner: no daemon, no
# privileged group. nixpkgs' package carries qemu, swtpm, OVMF (Secure Boot
# variants included) and usbutils on its PATH.
#
# Each machine is rendered for its owner:
#   ~/VMs/<name>.conf      the quickemu config (a bash file it sources)
#   ~/VMs/<name>/          disk.qcow2, OVMF vars, TPM state (persisted)
#   vm-<name>              starts it; `vm-<name> fetch` places pinned install media
# A Windows machine also gets the VirtIO drivers (nixpkgs' virtio-win ISO) and
# an unattended-setup disc built from the answer file in quickemu's own source,
# so it always matches the packaged quickemu: no TPM/Secure Boot/RAM/CPU check,
# no Microsoft account, a local `Quickemu` user. quickemu attaches that disc
# only while installing (its disk is still near-empty).
{ config, lib, pkgs, ... }:

with lib;

let
  cfg = config.my.virtualisation.vms;
  machines = filterAttrs (_: m: m.engine == "quickemu") cfg.machines;
  # Rendered only for owners that exist; an unknown owner is reported by the
  # assertion below rather than by home-manager failing on a missing account.
  rendered = filterAttrs (_: m: config.my.users ? ${m.owner}) machines;
  windows = filterAttrs (_: m: m.os == "windows") machines;

  owners = unique (mapAttrsToList (_: m: m.owner) rendered);
  quickemuUsers = unique (owners ++ optionals cfg.quickemu.enable cfg.quickemu.users);

  homeOf = user: config.users.users.${user}.home or "/home/${user}";

  # quickemu on the host-only QEMU libvirt and Incus run too, not a second
  # all-architecture build (~1 GiB). nixpkgs asks for
  # `qemu.override { smbdSupport = true; }`; answering with the plain
  # host-only build drops quickemu's Samba "public folder" share. nixpkgs
  # also patches quickemu to pass `smb=` unconditionally (its QEMU has
  # smbd), and QEMU without smbd then refuses to start the VM -- so the
  # share is switched off in the script too. ~/Public still reaches the
  # guest over WebDAV/9P.
  quickemu = (pkgs.quickemu.override {
    qemu = pkgs.qemu_kvm // { override = _: pkgs.qemu_kvm; };
  }).overrideAttrs (old: {
    postPatch = (old.postPatch or "") + ''
      substituteInPlace quickemu \
        --replace-fail 'if true || [ -x "/usr/sbin/smbd" ]' 'if false'
    '';
  });

  # quickget's autounattend.xml, cut out of the script it is a heredoc in.
  # Failing loudly beats an empty answer file, which Windows setup ignores.
  autounattend = pkgs.runCommand "quickemu-autounattend.xml" { } ''
    sed -n "/^    cat << 'EOF' > \"\''${1}\/unattended\/autounattend.xml\"$/,/^EOF$/p" \
      ${pkgs.quickemu.src}/quickget | sed '1d;$d' > $out
    grep -q '<unattend' $out || { echo "autounattend.xml not found in quickget" >&2; exit 1; }
  '';

  unattendedIso = pkgs.runCommand "quickemu-unattended.iso" { nativeBuildInputs = [ pkgs.cdrtools ]; } ''
    mkdir unattended
    cp ${autounattend} unattended/autounattend.xml
    mkisofs -quiet -J -o $out unattended
  '';

  onOff = b: if b then "on" else "off";

  confOf = name: m:
    let dir = "${homeOf m.owner}/VMs/${name}"; in
    ''
      #!${quickemu}/bin/quickemu --vm
      # Generated by mynixos (my.virtualisation.vms.machines.${name}); edits are overwritten.
      guest_os="${m.os}"
      boot="${if m.firmware.uefi then "efi" else "legacy"}"
      secureboot="${onOff m.firmware.secureBoot}"
      tpm="${onOff m.firmware.tpm}"
      cpu_cores="${toString m.cpus}"
      ram="${m.memory}"
      disk_img="${dir}/disk.qcow2"
      disk_size="${m.disk.size}"
      display="${m.display}"
    ''
    + optionalString (m.network != "nat") ''
      network="${m.network}"
    ''
    + optionalString (m.install.iso != null) ''
      iso="${dir}/install.iso"
    ''
    + optionalString (m.os == "windows") ''
      fixed_iso="${pkgs.virtio-win.src}"
    ''
    + optionalString (m.usb != [ ]) ''
      usb_devices=(${concatMapStringsSep " " (d: ''"${d.vendor}:${d.product}"'') m.usb})
    '';

  # `vm-<name>` starts the VM; `vm-<name> fetch [FILE|URL]` places pinned
  # install media. The ISO is verified once, when placed, and a stamp (hash,
  # size, mtime) lets later starts refuse swapped or truncated media without
  # re-hashing gigabytes every boot.
  launcher = name: m:
    let
      iso = m.install.iso;
      want = if iso != null then iso.sha256 else "";
      url = if iso != null && iso.url != null then iso.url else "";
    in
    pkgs.writeShellApplication {
      name = "vm-${name}";
      runtimeInputs = [ pkgs.coreutils pkgs.curl quickemu ];
      text = ''
        dir="$HOME/VMs/${name}"
        iso="$dir/install.iso"
        stamp="$dir/install.iso.verified"
        want="${want}"
        stampOf() { echo "$want $(stat -c '%s %Y' "$iso")"; }

        if [ "''${1:-}" = fetch ]; then
          [ -n "$want" ] || { echo "vm-${name}: no install.iso is declared for this machine" >&2; exit 2; }
          src="''${2:-${url}}"
          [ -n "$src" ] || { echo "usage: vm-${name} fetch FILE|URL" >&2; exit 2; }
          mkdir -p "$dir"
          tmp="$iso.partial"
          case "$src" in
            http://* | https://*) curl -L --fail -C - -o "$tmp" "$src" ;;
            *) cp --reflink=auto -- "$src" "$tmp" ;;
          esac
          echo "verifying SHA-256..."
          got="$(sha256sum "$tmp" | cut -d' ' -f1)"
          if [ "$got" != "$want" ]; then
            echo "vm-${name}: SHA-256 mismatch: got $got, expected $want" >&2
            rm -f "$tmp"
            exit 1
          fi
          mv -f "$tmp" "$iso"
          stampOf > "$stamp"
          echo "install media verified: $iso"
          exit 0
        fi

        if [ -n "$want" ]; then
          if [ ! -f "$iso" ] || [ "$(cat "$stamp" 2>/dev/null)" != "$(stampOf)" ]; then
            echo "vm-${name}: install media missing or unverified; run: vm-${name} fetch FILE|URL" >&2
            exit 1
          fi
        fi

        mkdir -p "$dir"
        exec quickemu --vm "$HOME/VMs/${name}.conf" "$@"
      '';
    };

  usbRules = pkgs.writeTextFile {
    name = "mynixos-vm-usb-rules";
    destination = "/lib/udev/rules.d/71-mynixos-vm-usb.rules";
    text = concatStrings (mapAttrsToList
      (name: m: concatMapStrings
        (d: ''
          # vms.machines.${name}: passed through by its owner's quickemu.
          SUBSYSTEM=="usb", ATTRS{idVendor}=="${d.vendor}", ATTRS{idProduct}=="${d.product}", OWNER="${m.owner}"
        '')
        m.usb)
      rendered);
  };
in
{
  config = mkMerge [
    (mkIf (quickemuUsers != [ ]) {
      home-manager.users = genAttrs quickemuUsers (_: {
        home.packages = [ quickemu ];
      });
    })

    (mkIf (machines != { }) {
      assertions =
        mapAttrsToList
          (name: m: {
            assertion = config.my.users ? ${m.owner};
            message = "my.virtualisation.vms.machines.${name}: owner `${m.owner}` is not in my.users.";
          })
          machines
        ++ mapAttrsToList
          (name: m: {
            assertion = m.firmware.secureBoot -> m.firmware.uefi;
            message = "my.virtualisation.vms.machines.${name}: firmware.secureBoot needs firmware.uefi.";
          })
          machines;

      home-manager.users = mkMerge (mapAttrsToList
        (name: m: {
          ${m.owner} = {
            home.packages = [ (launcher name m) ];
            home.file = {
              "VMs/${name}.conf".text = confOf name m;
            } // optionalAttrs (m.os == "windows") {
              "VMs/${name}/unattended.iso".source = unattendedIso;
            };
          };
        })
        rendered);

      # Disks, OVMF variables and TPM state survive a tmpfs root -- for the
      # owners only. Written to impermanence directly: defining my.users.<owner>
      # from here would make the set of users depend on itself.
      environment.persistence = mkIf config.my.storage.impermanence.enable {
        ${config.my.storage.impermanence.persistPath}.users =
          genAttrs owners (_: { directories = [ "VMs" ]; });
      };

      services.udev.packages = optional (any (m: m.usb != [ ]) (attrValues rendered)) usbRules;
    })

    # Windows probes MSRs KVM does not implement and, without this, can fail to
    # boot. quickemu's own fix writes /etc/modprobe.d with sudo, which cannot
    # work on NixOS.
    (mkIf (windows != { }) {
      boot.extraModprobeConfig = "options kvm ignore_msrs=1 report_ignored_msrs=0";
    })
  ];
}

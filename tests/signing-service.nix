# my.infra.signing: the shape of a signing service, and the cases it refuses.
#
# tests/vm-signing-service.nix proves the runtime claims. This proves, cheaply,
# that the unit stays shaped to make them, and that a host declaring no service
# gets nothing.
{ lib
, nixpkgs
, system
, self
, inputs
}:

let
  testLib = import ./lib.nix { inherit lib nixpkgs system self inputs; };
  inherit (testLib) pkgs specialArgs baseModules baseConfig;

  evalWith = testConfig:
    (lib.nixosSystem {
      inherit specialArgs;
      modules = baseModules ++ [ baseConfig { my.system.hostname = "signing-test"; } testConfig ];
    }).config;

  handler = pkgs.writeShellApplication {
    name = "fixture-handler";
    text = "exit 1";
  };

  withService = extra: evalWith (lib.recursiveUpdate
    {
      users.users.alice = { isNormalUser = true; };
      my.infra.signing.services.tool = {
        inherit handler;
        clients = [ "alice" ];
        instances.tool = { };
      };
    }
    extra);

  withReleasable = repositories: evalWith {
    users.users.alice = { isNormalUser = true; };
    my.infra.signing.releasable = {
      package = handler;
      inherit repositories;
      clients = [ "alice" ];
    };
  };

  ourFailures = cfg:
    map (a: a.message)
      (lib.filter (a: !a.assertion && lib.hasInfix "my.infra.signing" a.message) cfg.assertions);

  service = withService { };
  unit = service.systemd.services."signing-tool@".serviceConfig;
  keygen = service.systemd.services.signing-tool-keygen.serviceConfig;
  socket = service.systemd.sockets.signing-tool.socketConfig;

  check = name: cond: detail:
    pkgs.runCommand "signing-service-${name}" { } (
      if cond then "echo 'PASS: ${name}' > $out"
      else builtins.throw "FAIL: ${name} -- ${detail}"
    );
in
{
  signing-service-accepts-valid = check "accepts-valid"
    (ourFailures service == [ ])
    "a complete service raised an assertion: ${toString (ourFailures service)}";

  signing-service-rejects-unknown-client = check "rejects-unknown-client"
    (ourFailures (withService { my.infra.signing.services.tool.clients = [ "nobody-here" ]; }) != [ ])
    "a client with no account raised no assertion, and setfacl would fail at socket start";

  signing-service-rejects-container = check "rejects-container"
    (ourFailures (withService { boot.isContainer = true; }) != [ ])
    "a container raised no assertion, and LoadCredential cannot work there";

  # The key only ever arrives as a credential, generated under the service's
  # account and kept where impermanence will find it.
  signing-service-key-is-a-credential = check "key-is-a-credential"
    (unit.LoadCredential == "signing-key:/var/lib/signing-tool/key"
      && keygen.User == "signing-tool"
      && keygen.StateDirectory == "signing-tool"
      && builtins.elem "/var/lib/signing-tool" service.my.system.persistence.features.systemDirectories)
    "the key is not generated by its own account, kept, and delivered by LoadCredential";

  signing-service-own-account = check "own-account"
    (unit.User == "signing-tool"
      && service.users.users.signing-tool.isSystemUser
      && !(builtins.elem "signing-tool" service.users.users.alice.extraGroups))
    "the handler does not run under an account of its own";

  signing-service-socket-access = check "socket-access"
    (socket.SocketMode == "0600" && socket.Accept
      && lib.hasSuffix "setfacl -m u:alice:rw /run/signing/tool.sock" socket.ExecStartPost)
    "the socket is not closed to everyone but the named clients";

  signing-service-confined = check "confined"
    (unit.PrivateNetwork && unit.ProtectHome == "tmpfs" && unit.ProtectSystem == "strict"
      && unit.CapabilityBoundingSet == "" && unit.NoNewPrivileges)
    "the handler's confinement was loosened";

  signing-service-path = check "path"
    (
      let
        plain = builtins.unsafeDiscardStringContext;
        onPath = cfg: lib.hasInfix (plain "${pkgs.git}/bin")
          (plain cfg.systemd.services."signing-tool@".environment.PATH);
      in
      onPath (withService { my.infra.signing.services.tool.path = [ pkgs.git ]; })
      && !(onPath service)
    )
    "a package listed in path did not reach the handler's PATH, or one not listed did";

  # One key for every releasable repository, and an instance per repository: its
  # own socket, running the handler against that repository's history alone.
  signing-service-releasable-per-repository = check "releasable-per-repository"
    (
      let
        cfg = withReleasable { alpha = "/home/alice/src/alpha"; beta = "/srv/beta"; };
        svc = name: cfg.systemd.services."signing-${name}@";
        args = name: (svc name).serviceConfig.ExecStart;
        plain = builtins.unsafeDiscardStringContext;
      in
      lib.attrNames cfg.my.infra.signing.services == [ "pre-release" ]
      && lib.hasSuffix "signing handle --repo /home/alice/src/alpha/.git" (args "alpha")
      && lib.hasSuffix "signing handle --repo /srv/beta/.git" (args "beta")
      && (svc "alpha").serviceConfig.BindReadOnlyPaths == [ "/home/alice/src/alpha/.git" ]
      && (svc "beta").serviceConfig.BindReadOnlyPaths == [ "/srv/beta/.git" ]
      && lib.all
        (name: (svc name).serviceConfig.User == "signing-pre-release"
        && (svc name).serviceConfig.LoadCredential == "signing-key:/var/lib/signing-pre-release/key"
        && (svc name).requires == [ "signing-pre-release-keygen.service" ]) [ "alpha" "beta" ]
      && cfg.systemd.sockets.signing-alpha.socketConfig.ListenStream == "/run/signing/alpha.sock"
      && cfg.systemd.sockets.signing-beta.socketConfig.ListenStream == "/run/signing/beta.sock"
      && lib.hasSuffix "setfacl -m u:alice:rw /run/signing/beta.sock" cfg.systemd.sockets.signing-beta.socketConfig.ExecStartPost
      && !(cfg.systemd.services ? "signing-pre-release@")
      && lib.hasInfix (plain "${pkgs.git}/bin") (plain (svc "beta").environment.PATH)
      && ourFailures cfg == [ ]
    )
    "two checkouts did not become two instances of the one pre-release key, each with its own socket and history";

  # An instance name becomes a unit name and a socket file name.
  signing-service-instance-names = check "instance-names"
    (
      let
        services = name: (withReleasable { ${name} = "/srv/tool"; }).my.infra.signing.services;
        refused = name: !(builtins.tryEval (lib.attrNames (services name).pre-release.instances)).success;
      in
      refused "Tool" && refused "1tool" && refused "tool.x" && refused "a/b" && refused "a@b"
      && !(refused "tool-2")
    )
    "an instance name a unit or socket cannot have was not refused, or one it can have was";

  # An instance name is one socket and one handler template, so two services
  # cannot share it.
  signing-service-instance-unique = check "instance-unique"
    (lib.any (lib.hasInfix "used by more than one service")
      (ourFailures (withService { my.infra.signing.services.other = { inherit handler; instances.tool = { }; }; })))
    "an instance name used by two services raised no assertion";

  signing-service-absent-is-inert = check "absent-is-inert"
    (
      let plain = evalWith { }; in
      !(plain.users.users ? signing-tool)
      && !(plain.systemd.sockets ? signing-tool)
      && plain.my.infra.signing.services == { }
    )
    "a host declaring no signing service still gained part of one";
}
